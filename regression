//Regresion

// 1. Área de estudio (Valle de Aburrá - Medellín y laderas)
var region = ee.Geometry.Rectangle([-75.65, 6.20, -75.50, 6.35]);
Map.centerObject(region, 13);

// 2. [CORRECCIÓN] Definir la imagen de Alpha Earth
var image = ee.ImageCollection('GOOGLE/SATELLITE_EMBEDDING/V1/ANNUAL')
  .filterBounds(region)
  .filterDate('2025-01-01', '2025-12-31')
  .first()
  .clip(region);

// 3. Cargar Datos de Referencia (Dynamic World - Probabilidad de Construcción)
var builtUp = ee.ImageCollection('GOOGLE/DYNAMICWORLD/V1')
  .filterBounds(region)
  .filterDate('2023-01-01', '2023-12-31')
  .select('built') // Seleccionamos la probabilidad de que sea "área construida"
  .mean()
  .clip(region);

// 4. Unir los embeddings con el objetivo (builtUp)
var combined = image.addBands(builtUp);

// 5. Muestreo para que la IA aprenda la relación textura-construcción
var training = combined.sample({
  region: region, 
  scale: 10, 
  numPixels: 2000
});

// 6. Entrenar el Regresor (Modo REGRESSION)
var regressor = ee.Classifier.smileRandomForest(100)
  .setOutputMode('REGRESSION') // Predecimos un valor de 0 a 1 (densidad)
  .train({
    features: training, 
    classProperty: 'built', 
    inputProperties: image.bandNames()
  });

// 7. Generar el mapa de Densidad Urbana
var urbanDensity = image.classify(regressor);

// 8. Visualización: Gris claro (baja densidad) a Rojo (alta densidad urbana)
Map.addLayer(urbanDensity, {min: 0, max: 0.8, palette: ['#f7f7f7', '#cccccc', '#ff4d4d']}, 'Densidad de Construcción Medellín');